#!/bin/bash

# omarchy:summary=Remove Lutris, Wine, and all their configs and caches, plus umu-launcher unless Battle.net uses it.
# omarchy:requires-sudo=true

set -e

packages=(lutris wine-staging wine-mono wine-gecko winetricks python-protobuf)
umu=()

# Standalone Battle.net launches through the same umu-launcher, so it and its
# runtime stay while Battle.net's prefix is there.
if [[ -d $HOME/Games/battlenet ]]; then
  removed="Lutris, Wine, and their configs have been removed. umu-launcher stays for Battle.net."
else
  packages+=(umu-launcher)
  umu=("$HOME/.local/share/umu" "$HOME/.cache/umu")
  removed="Lutris, Wine, umu-launcher, and their configs have been removed."
fi

omarchy-pkg-drop "${packages[@]}"

rm -rf \
  "$HOME/.config/lutris" \
  "$HOME/.local/share/lutris" \
  "$HOME/.cache/lutris" \
  "${umu[@]}" \
  "$HOME/.wine" \
  "$HOME/.cache/wine" \
  "$HOME/.cache/winetricks"

echo ""
echo "$removed"
